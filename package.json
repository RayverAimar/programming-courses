{
  "name": "programming-courses",
  "version": "0.1.0",
  "description": "Programming courses at a robot workshop in Lima: a static bilingual site and a desktop app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "verify": "node scripts/verify.mjs",
    "app": "node scripts/build.mjs && electron .",
    "app:icons": "node platform/build/icons.mjs",
    "dist": "node scripts/build.mjs && node platform/build/icons.mjs && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "node scripts/build.mjs && node platform/build/icons.mjs && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "node scripts/build.mjs && node platform/build/icons.mjs && electron-builder --config electron-builder.config.cjs --win",
    "dist:linux": "node scripts/build.mjs && node platform/build/icons.mjs && electron-builder --config electron-builder.config.cjs --linux",
    "smoke": "node scripts/smoke-app.mjs"
  },
  "author": "Rayver Aimar Muñoz Curi",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@resvg/resvg-js": "2.6.2",
    "codemirror": "^6.0.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "lucide-static": "1.55.0",
    "marked": "^18.1.1",
    "playwright": "1.64.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "pyodide": "314.0.7",
    "sql.js": "1.14.2"
  },
  "main": "platform/electron/main.cjs",
  "homepage": "https://github.com/RayverAimar/programming-courses"
}
